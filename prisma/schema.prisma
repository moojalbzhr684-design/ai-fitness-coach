generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  USER
  SUPER_ADMIN
}

enum GymRole {
  OWNER
  TRAINER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Sex {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
}

enum Goal {
  FAT_LOSS
  MUSCLE_GAIN
  RECOMPOSITION
  STRENGTH
  GENERAL_FITNESS
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  HIGH
  VERY_HIGH
}

enum TrainingPlace {
  GYM
  HOME
  BOTH
}

enum OnboardingStep {
  AGE
  SEX
  HEIGHT
  WEIGHT
  ACTIVITY
  EXPERIENCE
  GOAL
  TRAINING_DAYS
  SESSION_MINUTES
  TRAINING_PLACE
  MEALS_PER_DAY
  WEEKLY_FOOD_BUDGET
  COMPLETE
}

enum MediaType {
  PHOTO
  DOCUMENT
}

enum MediaPurpose {
  PROGRESS_FRONT
  PROGRESS_SIDE
  PROGRESS_BACK
  MEAL
  OTHER
}

enum AIEventStatus {
  SUCCESS
  ERROR
}

model User {
  id               String         @id @default(cuid())
  telegramId       BigInt         @unique
  telegramUsername String?
  firstName        String?
  lastName         String?
  systemRole       SystemRole     @default(USER)
  onboardingStep   OnboardingStep @default(AGE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  profile        UserProfile?
  gymMemberships GymMembership[]
  media          Media[]
  aiEvents       AIEvent[]
  agentDecisions AgentDecision[]
  auditLogs      AuditLog[]      @relation("AuditActor")

  @@index([systemRole])
  @@index([onboardingStep])
}

model UserProfile {
  id                  String           @id @default(cuid())
  userId              String           @unique
  age                 Int?
  sex                 Sex?
  heightCm            Float?
  weightKg            Float?
  activityLevel       ActivityLevel?
  experienceLevel     ExperienceLevel?
  goal                Goal?
  trainingDaysPerWeek Int?
  sessionMinutes      Int?
  trainingPlace       TrainingPlace?
  mealsPerDay         Int?
  weeklyFoodBudgetIqd Int?
  foodPreferences     Json?
  dislikedFoods       Json?
  allergies           Json?
  dietaryRestrictions Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Gym {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  joinCode       String   @unique
  isActive       Boolean  @default(true)
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  aiName         String   @default("AI Coach")
  aiLanguage     String   @default("ar-IQ")
  themeConfig    Json?
  aiConfig       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    GymMembership[]
  media          Media[]
  aiEvents       AIEvent[]
  agentDecisions AgentDecision[]
  auditLogs      AuditLog[]

  @@index([isActive])
}

model GymMembership {
  id        String           @id @default(cuid())
  gymId     String
  userId    String
  role      GymRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId])
  @@index([userId, status])
  @@index([gymId, status])
  @@index([gymId, role, status])
}

model Media {
  id             String       @id @default(cuid())
  userId         String
  gymId          String?
  type           MediaType
  purpose        MediaPurpose
  telegramFileId String?
  storageKey     String?
  mimeType       String?
  sizeBytes      BigInt?
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym? @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([gymId, createdAt])
  @@index([type, purpose])
}

model AIEvent {
  id               String        @id @default(cuid())
  userId           String
  gymId            String?
  eventType        String
  status           AIEventStatus
  model            String?
  inputSummary     String?
  outputSummary    String?
  latencyMs        Int?
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Decimal?      @db.Decimal(12, 8)
  errorMessage     String?
  createdAt        DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym? @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([gymId, createdAt])
  @@index([status, createdAt])
  @@index([eventType, createdAt])
}

model AgentDecision {
  id                    String    @id @default(cuid())
  userId                String
  gymId                 String?
  decisionType          String
  oldValue              Json?
  newValue              Json?
  reason                String
  requiresCoachApproval Boolean   @default(false)
  approvedAt            DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym? @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([gymId, createdAt])
  @@index([requiresCoachApproval, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  gymId       String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  gym       Gym?  @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([gymId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}
