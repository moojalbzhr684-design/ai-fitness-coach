generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  USER
  SUPER_ADMIN
}

enum GymRole {
  OWNER
  TRAINER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Sex {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
}

enum Goal {
  FAT_LOSS
  MUSCLE_GAIN
  RECOMPOSITION
  STRENGTH
  GENERAL_FITNESS
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  HIGH
  VERY_HIGH
}

enum TrainingPlace {
  GYM
  HOME
  BOTH
}

enum OnboardingStep {
  AGE
  SEX
  HEIGHT
  WEIGHT
  ACTIVITY
  EXPERIENCE
  GOAL
  TRAINING_DAYS
  SESSION_MINUTES
  TRAINING_PLACE
  MEALS_PER_DAY
  WEEKLY_FOOD_BUDGET
  COMPLETE
}

enum MediaType {
  PHOTO
  DOCUMENT
}

enum MediaPurpose {
  PROGRESS_FRONT
  PROGRESS_SIDE
  PROGRESS_BACK
  MEAL
  OTHER
}

enum PhotoView {
  FRONT
  SIDE
  BACK
  OTHER
}

enum PhotoAnalysisStatus {
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

enum MediaVisibility {
  PRIVATE
  TRAINER_ALLOWED
  GYM_ALLOWED
}

enum AIEventStatus {
  PROCESSING
  SUCCESS
  ERROR
}

enum AgentMemoryCategory {
  FOOD_PREFERENCE
  FOOD_DISLIKE
  TRAINING_PREFERENCE
  SCHEDULE_PREFERENCE
  EXERCISE_PREFERENCE
  COACHING_PREFERENCE
  USER_STATED_CONSTRAINT
}

enum AIToolExecutionStatus {
  SUCCESS
  ERROR
  TIMEOUT
  REJECTED
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  ABS
  FOREARMS
  FULL_BODY
}

enum ExerciseType {
  COMPOUND
  ISOLATION
}

enum EquipmentType {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  SMITH_MACHINE
  EZ_BAR
  KETTLEBELL
  OTHER
}

enum MovementPattern {
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  SQUAT
  HINGE
  LUNGE
  ELBOW_FLEXION
  ELBOW_EXTENSION
  SHOULDER_ABDUCTION
  CALF_RAISE
  CORE
  OTHER
}

enum WorkoutSplit {
  FULL_BODY
  UPPER_LOWER
  PUSH_PULL_LEGS
  CUSTOM
}

enum WorkoutProgramStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

enum WorkoutSessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum NutritionPlanStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PRE_WORKOUT
  POST_WORKOUT
  OTHER
}

enum FoodCategory {
  PROTEIN
  CARBOHYDRATE
  FAT
  VEGETABLE
  FRUIT
  DAIRY
  LEGUME
  MIXED_MEAL
  OTHER
}

enum FoodUnit {
  GRAM
  MILLILITER
  PIECE
}

enum DietaryTag {
  HALAL
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  DAIRY_FREE
  OTHER
}

enum CheckInStatus {
  DRAFT
  SUBMITTED
  EVALUATED
}

enum CheckInStep {
  WEIGHT
  WAIST
  NUTRITION_ADHERENCE
  WORKOUTS_COMPLETED
  STEPS
  SLEEP
  HUNGER
  ENERGY
  NOTES
  COMPLETE
}

enum ProgressDecisionAction {
  COLLECT_MORE_DATA
  KEEP_CURRENT_PLAN
  DECREASE_CALORIES
  INCREASE_CALORIES
  INCREASE_STEPS
  REVIEW_ADHERENCE
  COACH_REVIEW_REQUIRED
}

enum ApprovalType {
  NUTRITION_ADJUSTMENT
  WORKOUT_ADJUSTMENT
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum IdentityProvider {
  TELEGRAM
  EMAIL
  PHONE
  APPLE
  GOOGLE
}

enum AuthChallengePurpose {
  LOGIN
  LINK_IDENTITY
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

model User {
  id               String         @id @default(cuid())
  telegramId       BigInt?        @unique
  telegramUsername String?
  firstName        String?
  lastName         String?
  systemRole       SystemRole     @default(USER)
  onboardingStep   OnboardingStep @default(AGE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  profile                 UserProfile?
  gymMemberships          GymMembership[]
  media                   Media[]
  aiEvents                AIEvent[]
  agentMemories           AgentMemory[]
  aiToolExecutions        AIToolExecution[]
  agentDecisions          AgentDecision[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  workoutPrograms         WorkoutProgram[]
  workoutSessions         WorkoutSession[]
  nutritionTargets        NutritionTarget[]
  nutritionPlans          NutritionPlan[]
  bodyMeasurements        BodyMeasurement[]
  weeklyCheckIns          WeeklyCheckIn[]
  progressEvaluations     ProgressEvaluation[]
  progressPhotoSets       ProgressPhotoSet[]
  photoAnalyses           ProgressPhotoAnalysis[]
  trainerProfile          TrainerProfile?
  trainerAssignments      TrainerAssignment[]      @relation("AssignedTrainer")
  memberAssignments       TrainerAssignment[]      @relation("AssignedMember")
  trainerPreferences      TrainerPreferences[]
  memberApprovals         ApprovalRequest[]        @relation("ApprovalMember")
  trainerApprovals        ApprovalRequest[]        @relation("ApprovalTrainer")
  reviewedApprovals       ApprovalRequest[]        @relation("ApprovalReviewer")
  identities              UserIdentity[]
  authSessions            AuthSession[]
  authChallenges          AuthChallenge[]
  telegramLoginChallenges TelegramLoginChallenge[]
  agentConversations      AgentConversation[]

  @@index([systemRole])
  @@index([onboardingStep])
}

model UserProfile {
  id                      String           @id @default(cuid())
  userId                  String           @unique
  age                     Int?
  sex                     Sex?
  heightCm                Float?
  weightKg                Float?
  activityLevel           ActivityLevel?
  experienceLevel         ExperienceLevel?
  goal                    Goal?
  trainingDaysPerWeek     Int?
  sessionMinutes          Int?
  trainingPlace           TrainingPlace?
  mealsPerDay             Int?
  weeklyFoodBudgetIqd     Int?
  foodPreferences         Json?
  dislikedFoods           Json?
  allergies               Json?
  dietaryRestrictions     Json?
  allowVisionAnalysis     Boolean          @default(false)
  allowTrainerPhotoAccess Boolean          @default(false)
  allowGymPhotoAccess     Boolean          @default(false)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Gym {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  joinCode       String   @unique
  isActive       Boolean  @default(true)
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  aiName         String   @default("AI Coach")
  aiLanguage     String   @default("ar-IQ")
  themeConfig    Json?
  aiConfig       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships          GymMembership[]
  media                Media[]
  aiEvents             AIEvent[]
  agentMemories        AgentMemory[]
  aiToolExecutions     AIToolExecution[]
  agentDecisions       AgentDecision[]
  auditLogs            AuditLog[]
  workoutPrograms      WorkoutProgram[]
  workoutSessions      WorkoutSession[]
  nutritionTargets     NutritionTarget[]
  nutritionPlans       NutritionPlan[]
  bodyMeasurements     BodyMeasurement[]
  weeklyCheckIns       WeeklyCheckIn[]
  progressEvaluations  ProgressEvaluation[]
  progressPhotoSets    ProgressPhotoSet[]
  photoAnalyses        ProgressPhotoAnalysis[]
  settings             GymSettings?
  trainerAssignments   TrainerAssignment[]
  trainerPreferences   TrainerPreferences[]
  approvalRequests     ApprovalRequest[]
  exerciseAvailability GymExerciseAvailability[]
  agentConversations   AgentConversation[]

  @@index([isActive])
}

model UserIdentity {
  id              String           @id @default(cuid())
  userId          String
  provider        IdentityProvider
  providerSubject String
  email           String?
  phone           String?
  isVerified      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lastUsedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId, provider])
  @@index([email])
}

model AuthChallenge {
  id            String               @id @default(cuid())
  email         String
  codeHash      String
  purpose       AuthChallengePurpose
  linkUserId    String?
  requestIpHash String?
  expiresAt     DateTime
  usedAt        DateTime?
  attemptCount  Int                  @default(0)
  createdAt     DateTime             @default(now())

  linkUser User? @relation(fields: [linkUserId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([requestIpHash, createdAt])
  @@index([expiresAt, usedAt])
}

model AuthSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  csrfTokenHash String
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model TelegramLoginChallenge {
  id               String    @id @default(cuid())
  browserTokenHash String    @unique
  botTokenHash     String    @unique
  requestIpHash    String?
  verifiedUserId   String?
  expiresAt        DateTime
  verifiedAt       DateTime?
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  verifiedUser User? @relation(fields: [verifiedUserId], references: [id], onDelete: SetNull)

  @@index([requestIpHash, createdAt])
  @@index([expiresAt, consumedAt])
  @@index([verifiedUserId, verifiedAt])
}

model AgentConversation {
  id            String   @id @default(cuid())
  userId        String
  gymId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym      Gym?           @relation(fields: [gymId], references: [id], onDelete: SetNull)
  messages AgentMessage[]

  @@index([userId, lastMessageAt])
  @@index([gymId, lastMessageAt])
}

model AgentMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           AgentMessageRole
  content        String
  createdAt      DateTime         @default(now())

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model GymMembership {
  id        String           @id @default(cuid())
  gymId     String
  userId    String
  role      GymRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gymId, userId])
  @@index([userId, status])
  @@index([gymId, status])
  @@index([gymId, role, status])
}

model Media {
  id             String       @id @default(cuid())
  userId         String
  gymId          String?
  type           MediaType
  purpose        MediaPurpose
  telegramFileId String?
  storageKey     String?
  mimeType       String?
  sizeBytes      BigInt?
  width          Int?
  height         Int?
  createdAt      DateTime     @default(now())

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym             Gym?           @relation(fields: [gymId], references: [id], onDelete: SetNull)
  progressPhoto   ProgressPhoto?
  gymSettingsLogo GymSettings?

  @@index([userId, createdAt])
  @@index([gymId, createdAt])
  @@index([type, purpose])
}

model ProgressPhotoSet {
  id                String    @id @default(cuid())
  userId            String
  gymId             String?
  capturedAt        DateTime
  weightKg          Float?
  waistCm           Float?
  notes             String?
  analysisRequested Boolean   @default(false)
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym      Gym?                   @relation(fields: [gymId], references: [id], onDelete: SetNull)
  photos   ProgressPhoto[]
  analysis ProgressPhotoAnalysis?

  @@index([userId, capturedAt])
  @@index([userId, completedAt])
  @@index([gymId, capturedAt])
}

model ProgressPhoto {
  id         String          @id @default(cuid())
  photoSetId String
  mediaId    String          @unique
  view       PhotoView
  visibility MediaVisibility @default(PRIVATE)
  createdAt  DateTime        @default(now())

  photoSet ProgressPhotoSet @relation(fields: [photoSetId], references: [id], onDelete: Cascade)
  media    Media            @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([photoSetId, view])
  @@index([photoSetId])
  @@index([visibility])
}

model ProgressPhotoAnalysis {
  id                String              @id @default(cuid())
  photoSetId        String              @unique
  userId            String
  gymId             String?
  status            PhotoAnalysisStatus @default(PENDING)
  model             String?
  overallSummary    String?
  frontSummary      String?
  sideSummary       String?
  backSummary       String?
  symmetryNotes     String?
  postureNotes      String?
  muscularityNotes  String?
  leannessNotes     String?
  comparisonSummary String?
  confidenceLabel   String?
  errorMessage      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  photoSet ProgressPhotoSet @relation(fields: [photoSetId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym      Gym?             @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([gymId, createdAt])
  @@index([status, createdAt])
}

model AIEvent {
  id               String        @id @default(cuid())
  userId           String
  gymId            String?
  eventType        String
  status           AIEventStatus
  model            String?
  inputSummary     String?
  outputSummary    String?
  latencyMs        Int?
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Decimal?      @db.Decimal(12, 8)
  errorMessage     String?
  createdAt        DateTime      @default(now())

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym            Gym?              @relation(fields: [gymId], references: [id], onDelete: SetNull)
  toolExecutions AIToolExecution[]

  @@index([userId, createdAt])
  @@index([gymId, createdAt])
  @@index([status, createdAt])
  @@index([eventType, createdAt])
}

model AgentMemory {
  id              String              @id @default(cuid())
  userId          String
  gymId           String?
  category        AgentMemoryCategory
  key             String
  value           Json
  source          String?
  confidence      Float?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  lastConfirmedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym? @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@unique([userId, category, key])
  @@index([userId, isActive, updatedAt])
  @@index([gymId, isActive])
}

model AIToolExecution {
  id            String                @id @default(cuid())
  aiEventId     String?
  userId        String
  gymId         String?
  toolName      String
  status        AIToolExecutionStatus
  durationMs    Int?
  inputSummary  String?
  outputSummary String?
  errorMessage  String?
  createdAt     DateTime              @default(now())

  aiEvent AIEvent? @relation(fields: [aiEventId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym     Gym?     @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([aiEventId, createdAt])
  @@index([userId, createdAt])
  @@index([gymId, createdAt])
  @@index([toolName, status, createdAt])
}

model AgentDecision {
  id                    String    @id @default(cuid())
  userId                String
  gymId                 String?
  decisionType          String
  oldValue              Json?
  newValue              Json?
  reason                String
  requiresCoachApproval Boolean   @default(false)
  approvedAt            DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym             Gym?             @relation(fields: [gymId], references: [id], onDelete: SetNull)
  approvalRequest ApprovalRequest?

  @@index([userId, createdAt])
  @@index([gymId, createdAt])
  @@index([requiresCoachApproval, createdAt])
}

model GymSettings {
  id                                        String   @id @default(cuid())
  gymId                                     String   @unique
  displayName                               String?
  aiDisplayName                             String?
  primaryColor                              String?
  secondaryColor                            String?
  logoMediaId                               String?  @unique
  defaultLanguage                           String   @default("ar-IQ")
  requireTrainerApprovalForNutritionChanges Boolean  @default(true)
  requireTrainerApprovalForWorkoutChanges   Boolean  @default(true)
  allowAutomaticProgressRecommendations     Boolean  @default(true)
  trainingPhilosophy                        String?
  defaultSessionMinutes                     Int?
  preferredSplitConfig                      Json?
  allowedEquipment                          Json?
  welcomeMessage                            String?
  createdAt                                 DateTime @default(now())
  updatedAt                                 DateTime @updatedAt

  gym       Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  logoMedia Media? @relation(fields: [logoMediaId], references: [id], onDelete: SetNull)
}

model TrainerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String?
  bio             String?
  specialties     Json?
  yearsExperience Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model TrainerAssignment {
  id            String   @id @default(cuid())
  gymId         String
  trainerUserId String
  memberUserId  String
  isPrimary     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  gym     Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer User @relation("AssignedTrainer", fields: [trainerUserId], references: [id], onDelete: Cascade)
  member  User @relation("AssignedMember", fields: [memberUserId], references: [id], onDelete: Cascade)

  @@unique([gymId, trainerUserId, memberUserId])
  @@index([gymId, trainerUserId])
  @@index([gymId, memberUserId, isPrimary])
}

model TrainerPreferences {
  id                    String   @id @default(cuid())
  trainerUserId         String
  gymId                 String
  preferredWorkoutStyle String?
  preferredRepRanges    Json?
  exercisePreferences   Json?
  nutritionNotes        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  trainer User @relation(fields: [trainerUserId], references: [id], onDelete: Cascade)
  gym     Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([trainerUserId, gymId])
  @@index([gymId])
}

model ApprovalRequest {
  id               String         @id @default(cuid())
  reference        String         @unique
  gymId            String
  memberUserId     String
  trainerUserId    String?
  agentDecisionId  String?        @unique
  type             ApprovalType
  status           ApprovalStatus @default(PENDING)
  requestedChange  Json
  currentValue     Json?
  reason           String
  createdAt        DateTime       @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewNote       String?
  expiresAt        DateTime?

  gym           Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member        User           @relation("ApprovalMember", fields: [memberUserId], references: [id], onDelete: Cascade)
  trainer       User?          @relation("ApprovalTrainer", fields: [trainerUserId], references: [id], onDelete: SetNull)
  agentDecision AgentDecision? @relation(fields: [agentDecisionId], references: [id], onDelete: SetNull)
  reviewer      User?          @relation("ApprovalReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([gymId, status, createdAt])
  @@index([trainerUserId, status, createdAt])
  @@index([memberUserId, status, createdAt])
  @@index([expiresAt, status])
}

model GymExerciseAvailability {
  id          String   @id @default(cuid())
  gymId       String
  exerciseId  String
  isAvailable Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gym      Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([gymId, exerciseId])
  @@index([gymId, isAvailable])
  @@index([exerciseId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  gymId       String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  gym       Gym?  @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([gymId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model Exercise {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  primaryMuscle    MuscleGroup
  secondaryMuscles Json?
  exerciseType     ExerciseType
  equipment        EquipmentType
  movementPattern  MovementPattern
  difficulty       ExperienceLevel
  instructions     String?
  videoUrl         String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  workoutDayExercises WorkoutDayExercise[]
  exerciseLogs        ExerciseLog[]
  substitutions       ExerciseSubstitution[]    @relation("ExerciseSubstitutions")
  substitutedBy       ExerciseSubstitution[]    @relation("SubstituteExercise")
  gymAvailability     GymExerciseAvailability[]

  @@index([primaryMuscle, isActive])
  @@index([movementPattern, equipment, isActive])
  @@index([difficulty, isActive])
}

model ExerciseSubstitution {
  id                   String  @id @default(cuid())
  exerciseId           String
  substituteExerciseId String
  priority             Int     @default(1)
  reason               String?

  exercise           Exercise @relation("ExerciseSubstitutions", fields: [exerciseId], references: [id], onDelete: Cascade)
  substituteExercise Exercise @relation("SubstituteExercise", fields: [substituteExerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, substituteExerciseId])
  @@index([exerciseId, priority])
  @@index([substituteExerciseId])
}

model WorkoutProgram {
  id                  String               @id @default(cuid())
  userId              String
  gymId               String?
  name                String
  split               WorkoutSplit
  status              WorkoutProgramStatus
  trainingDaysPerWeek Int
  startedAt           DateTime
  endedAt             DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym      Gym?             @relation(fields: [gymId], references: [id], onDelete: SetNull)
  days     WorkoutDay[]
  sessions WorkoutSession[]

  @@index([userId, status])
  @@index([gymId, status])
  @@index([userId, startedAt])
}

model WorkoutDay {
  id        String   @id @default(cuid())
  programId String
  dayNumber Int
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program   WorkoutProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises WorkoutDayExercise[]
  sessions  WorkoutSession[]

  @@unique([programId, dayNumber])
  @@index([programId])
}

model WorkoutDayExercise {
  id               String   @id @default(cuid())
  workoutDayId     String
  exerciseId       String
  order            Int
  sets             Int
  repMin           Int
  repMax           Int
  restSeconds      Int
  rirTarget        Int?
  startingWeightKg Float?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workoutDay WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutDayId, order])
  @@index([workoutDayId])
  @@index([exerciseId])
}

model WorkoutSession {
  id              String               @id @default(cuid())
  userId          String
  gymId           String?
  programId       String?
  workoutDayId    String?
  status          WorkoutSessionStatus
  startedAt       DateTime?
  completedAt     DateTime?
  durationMinutes Int?
  userNotes       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym          Gym?            @relation(fields: [gymId], references: [id], onDelete: SetNull)
  program      WorkoutProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  workoutDay   WorkoutDay?     @relation(fields: [workoutDayId], references: [id], onDelete: SetNull)
  exerciseLogs ExerciseLog[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([gymId, createdAt])
  @@index([programId])
  @@index([workoutDayId])
}

model ExerciseLog {
  id               String   @id @default(cuid())
  workoutSessionId String
  exerciseId       String
  order            Int
  createdAt        DateTime @default(now())

  workoutSession WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise       Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  setLogs        SetLog[]

  @@unique([workoutSessionId, order])
  @@index([workoutSessionId])
  @@index([exerciseId])
}

model SetLog {
  id            String   @id @default(cuid())
  exerciseLogId String
  setNumber     Int
  weightKg      Float?
  reps          Int
  rir           Int?
  isWarmup      Boolean  @default(false)
  completedAt   DateTime @default(now())

  exerciseLog ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)

  @@unique([exerciseLogId, setNumber])
  @@index([exerciseLogId, completedAt])
}

model Food {
  id                     String       @id @default(cuid())
  name                   String
  nameAr                 String?
  slug                   String       @unique
  category               FoodCategory
  caloriesPer100g        Float
  proteinPer100g         Float
  carbsPer100g           Float
  fatPer100g             Float
  fiberPer100g           Float?
  defaultUnit            FoodUnit     @default(GRAM)
  defaultServingGrams    Float?
  estimatedPriceIqdPerKg Float?
  dietaryTags            Json?
  allergenTags           Json?
  isIraqiCommon          Boolean      @default(false)
  isActive               Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  mealItems     MealItem[]
  substitutions FoodSubstitution[] @relation("FoodSubstitutions")
  substitutedBy FoodSubstitution[] @relation("SubstituteFood")

  @@index([category])
  @@index([isIraqiCommon])
  @@index([isActive])
  @@index([category, isActive])
}

model FoodSubstitution {
  id               String   @id @default(cuid())
  foodId           String
  substituteFoodId String
  priority         Int      @default(1)
  reason           String?
  createdAt        DateTime @default(now())

  food           Food @relation("FoodSubstitutions", fields: [foodId], references: [id], onDelete: Cascade)
  substituteFood Food @relation("SubstituteFood", fields: [substituteFoodId], references: [id], onDelete: Cascade)

  @@unique([foodId, substituteFoodId])
  @@index([foodId, priority])
  @@index([substituteFoodId])
}

model NutritionTarget {
  id                           String   @id @default(cuid())
  userId                       String
  gymId                        String?
  calories                     Int
  proteinGrams                 Float
  carbsGrams                   Float
  fatGrams                     Float
  estimatedMaintenanceCalories Int?
  goal                         Goal
  calculationVersion           String
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym   Gym?            @relation(fields: [gymId], references: [id], onDelete: SetNull)
  plans NutritionPlan[]

  @@index([userId, createdAt])
  @@index([gymId, createdAt])
  @@index([goal, calculationVersion])
}

model NutritionPlan {
  id                     String              @id @default(cuid())
  userId                 String
  gymId                  String?
  targetId               String
  name                   String
  status                 NutritionPlanStatus
  mealsPerDay            Int
  dailyCalories          Int
  dailyProteinGrams      Float
  dailyCarbsGrams        Float
  dailyFatGrams          Float
  estimatedDailyCostIqd  Int?
  estimatedWeeklyCostIqd Int?
  startedAt              DateTime
  endedAt                DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym    Gym?            @relation(fields: [gymId], references: [id], onDelete: SetNull)
  target NutritionTarget @relation(fields: [targetId], references: [id], onDelete: Restrict)
  meals  Meal[]

  @@index([userId, status])
  @@index([gymId, status])
  @@index([targetId])
  @@index([userId, startedAt])
}

model Meal {
  id              String   @id @default(cuid())
  nutritionPlanId String
  order           Int
  mealType        MealType
  name            String
  targetCalories  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  nutritionPlan NutritionPlan @relation(fields: [nutritionPlanId], references: [id], onDelete: Cascade)
  items         MealItem[]

  @@unique([nutritionPlanId, order])
  @@index([nutritionPlanId])
}

model MealItem {
  id            String   @id @default(cuid())
  mealId        String
  foodId        String
  order         Int
  quantityGrams Float
  calories      Float
  proteinGrams  Float
  carbsGrams    Float
  fatGrams      Float
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@unique([mealId, order])
  @@index([mealId])
  @@index([foodId])
}

model BodyMeasurement {
  id         String   @id @default(cuid())
  userId     String
  gymId      String?
  weightKg   Float
  waistCm    Float?
  measuredAt DateTime
  source     String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym? @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([userId, measuredAt])
  @@index([gymId, measuredAt])
}

model WeeklyCheckIn {
  id                       String        @id @default(cuid())
  userId                   String
  gymId                    String?
  status                   CheckInStatus @default(DRAFT)
  currentStep              CheckInStep   @default(WEIGHT)
  weightKg                 Float?
  waistCm                  Float?
  nutritionAdherencePct    Int?
  workoutsCompleted        Int?
  trackedWorkoutsCompleted Int?
  averageDailySteps        Int?
  averageSleepHours        Float?
  hungerRating             Int?
  energyRating             Int?
  notes                    String?
  submittedAt              DateTime?
  evaluatedAt              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym        Gym?                @relation(fields: [gymId], references: [id], onDelete: SetNull)
  evaluation ProgressEvaluation?

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([gymId, createdAt])
}

model ProgressEvaluation {
  id                        String                 @id @default(cuid())
  checkInId                 String                 @unique
  userId                    String
  gymId                     String?
  action                    ProgressDecisionAction
  weightTrendKgPerWeek      Float?
  weightTrendPercentPerWeek Float?
  recommendedCaloriesDelta  Int?
  recommendedStepsDelta     Int?
  requiresCoachApproval     Boolean                @default(false)
  reasonCodes               Json?
  summary                   String
  createdAt                 DateTime               @default(now())

  checkIn WeeklyCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym     Gym?          @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([gymId, createdAt])
  @@index([action, createdAt])
}
