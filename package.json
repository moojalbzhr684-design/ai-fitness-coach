{
  "name": "ai-fitness-coach",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "description": "Multi-tenant AI fitness coaching platform foundation",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src",
    "web:dev": "npm run dev --workspace @ai-fitness-coach/web",
    "web:typecheck": "npm run typecheck --workspace @ai-fitness-coach/web",
    "web:test": "npm run test --workspace @ai-fitness-coach/web",
    "web:build": "npm run build --workspace @ai-fitness-coach/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "grammy": "1.45.1",
    "openai": "7.5.0",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
